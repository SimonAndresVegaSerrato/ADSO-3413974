<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_GestionHorariosCompleto" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.50.1">
  <bpmn:collaboration id="Collaboration_GestionHorarios">
    <bpmn:participant id="Participant_Sistema" name="Sistema de Gestión de Horarios" processRef="Process_GestionHorarios" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GestionHorarios" name="Proceso integral de gestión de horarios" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_Sistema" name="SISTEMA">
        <bpmn:flowNodeRef>ValidarCredenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayCredenciales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CargarRol</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MostrarModulo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GuardarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ActualizarDatos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GenerarIndicadores</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ProcesarDocumentos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AplicarParametros</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Parametrizacion" name="PARAMETRIZACIÓN">
        <bpmn:flowNodeRef>AdministrarParametros</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ActualizarParametros</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Soporte" name="ADMINISTRADOR DE SOPORTE">
        <bpmn:flowNodeRef>GestionDocumentos</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Director" name="DIRECTOR DE CENTRO">
        <bpmn:flowNodeRef>ConsultarIndicadores</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Coordinador" name="COORDINADOR ACADÉMICO">
        <bpmn:flowNodeRef>GestionHorarios</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ValidarHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GatewayHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PublicarHorario</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Instructor" name="INSTRUCTOR">
        <bpmn:flowNodeRef>GestionHorarioInstructor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsultaHorarioInstructor</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Aprendiz" name="APRENDIZ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Login</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsultaHorario</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ConsultaResultados</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CerrarSesion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Inicio" />
    <bpmn:userTask id="Login" name="Ingresar al sistema (Login)" />
    <bpmn:serviceTask id="ValidarCredenciales" name="Validar credenciales" />
    <bpmn:exclusiveGateway id="GatewayCredenciales" name="¿Credenciales válidas?" />
    <bpmn:serviceTask id="CargarRol" name="Identificar rol y cargar permisos" />
    <bpmn:serviceTask id="MostrarModulo" name="Mostrar módulo autorizado" />
    <bpmn:userTask id="ConsultaHorario" name="Consultar horario" />
    <bpmn:userTask id="ConsultaResultados" name="Consultar información disponible" />
    <bpmn:userTask id="GestionHorarioInstructor" name="Gestionar información del horario" />
    <bpmn:userTask id="ConsultaHorarioInstructor" name="Consultar horario" />
    <bpmn:userTask id="GestionHorarios" name="Gestionar horarios académicos" />
    <bpmn:userTask id="ValidarHorario" name="Revisar y validar horario" />
    <bpmn:exclusiveGateway id="GatewayHorario" name="¿Horario válido?" />
    <bpmn:userTask id="PublicarHorario" name="Publicar horario" />
    <bpmn:userTask id="ConsultarIndicadores" name="Consultar indicadores" />
    <bpmn:userTask id="GestionDocumentos" name="Gestionar documentos / soporte" />
    <bpmn:userTask id="AdministrarParametros" name="Administrar parámetros" />
    <bpmn:userTask id="ActualizarParametros" name="Actualizar configuración" />
    <bpmn:serviceTask id="GuardarHorario" name="Guardar / actualizar horario" />
    <bpmn:serviceTask id="ActualizarDatos" name="Actualizar información del sistema" />
    <bpmn:serviceTask id="GenerarIndicadores" name="Generar indicadores" />
    <bpmn:serviceTask id="ProcesarDocumentos" name="Procesar información de soporte" />
    <bpmn:serviceTask id="AplicarParametros" name="Aplicar parametrización" />
    <bpmn:userTask id="CerrarSesion" name="Cerrar sesión" />
    <bpmn:endEvent id="End" name="Fin" />
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="Login" />
    <bpmn:sequenceFlow id="F05" name="No" sourceRef="GatewayCredenciales" targetRef="Login" />
    <bpmn:sequenceFlow id="F02" sourceRef="Login" targetRef="ValidarCredenciales" />
    <bpmn:sequenceFlow id="F03" sourceRef="ValidarCredenciales" targetRef="GatewayCredenciales" />
    <bpmn:sequenceFlow id="F04" name="Sí" sourceRef="GatewayCredenciales" targetRef="CargarRol" />
    <bpmn:sequenceFlow id="F06" sourceRef="CargarRol" targetRef="MostrarModulo" />
    <bpmn:sequenceFlow id="F07" sourceRef="MostrarModulo" targetRef="ConsultaHorario" />
    <bpmn:sequenceFlow id="F10" sourceRef="MostrarModulo" targetRef="GestionHorarioInstructor" />
    <bpmn:sequenceFlow id="F13" sourceRef="MostrarModulo" targetRef="GestionHorarios" />
    <bpmn:sequenceFlow id="F19" sourceRef="MostrarModulo" targetRef="ConsultarIndicadores" />
    <bpmn:sequenceFlow id="F22" sourceRef="MostrarModulo" targetRef="GestionDocumentos" />
    <bpmn:sequenceFlow id="F25" sourceRef="MostrarModulo" targetRef="AdministrarParametros" />
    <bpmn:sequenceFlow id="F08" sourceRef="ConsultaHorario" targetRef="ConsultaResultados" />
    <bpmn:sequenceFlow id="F09" sourceRef="ConsultaResultados" targetRef="CerrarSesion" />
    <bpmn:sequenceFlow id="F11" sourceRef="GestionHorarioInstructor" targetRef="ConsultaHorarioInstructor" />
    <bpmn:sequenceFlow id="F12" sourceRef="ConsultaHorarioInstructor" targetRef="GuardarHorario" />
    <bpmn:sequenceFlow id="F17" name="No: corregir" sourceRef="GatewayHorario" targetRef="GestionHorarios" />
    <bpmn:sequenceFlow id="F14" sourceRef="GestionHorarios" targetRef="ValidarHorario" />
    <bpmn:sequenceFlow id="F15" sourceRef="ValidarHorario" targetRef="GatewayHorario" />
    <bpmn:sequenceFlow id="F16" name="Sí" sourceRef="GatewayHorario" targetRef="PublicarHorario" />
    <bpmn:sequenceFlow id="F18" sourceRef="PublicarHorario" targetRef="GuardarHorario" />
    <bpmn:sequenceFlow id="F20" sourceRef="ConsultarIndicadores" targetRef="GenerarIndicadores" />
    <bpmn:sequenceFlow id="F23" sourceRef="GestionDocumentos" targetRef="ProcesarDocumentos" />
    <bpmn:sequenceFlow id="F26" sourceRef="AdministrarParametros" targetRef="ActualizarParametros" />
    <bpmn:sequenceFlow id="F27" sourceRef="ActualizarParametros" targetRef="AplicarParametros" />
    <bpmn:sequenceFlow id="F29" sourceRef="GuardarHorario" targetRef="ActualizarDatos" />
    <bpmn:sequenceFlow id="F30" sourceRef="ActualizarDatos" targetRef="CerrarSesion" />
    <bpmn:sequenceFlow id="F21" sourceRef="GenerarIndicadores" targetRef="CerrarSesion" />
    <bpmn:sequenceFlow id="F24" sourceRef="ProcesarDocumentos" targetRef="CerrarSesion" />
    <bpmn:sequenceFlow id="F28" sourceRef="AplicarParametros" targetRef="CerrarSesion" />
    <bpmn:sequenceFlow id="F31" sourceRef="CerrarSesion" targetRef="End" />
  </bpmn:process>
